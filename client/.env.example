# API Configuration
# API_MODE: mock | hybrid | live
NEXT_PUBLIC_API_MODE=hybrid

# Express Server Configuration
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5001

# Mock API Configuration  
NEXT_PUBLIC_MOCK_API_URL=http://localhost:8080

# API Migration Settings
# Comma-separated list of API endpoints to use Express server for
# 완료된 API들: auth (signin, signup, refresh, signout), users (getMe, updateMe)
NEXT_PUBLIC_EXPRESS_ENDPOINTS=auth,users

# Debug mode for API calls
NEXT_PUBLIC_API_DEBUG=true 